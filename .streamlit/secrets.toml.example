# Copy this to .streamlit/secrets.toml (gitignored) and fill in real values
# for local development. On Railway, this file is generated automatically
# at startup from AE_GOOGLE_CLIENT_ID / AE_GOOGLE_CLIENT_SECRET /
# AE_AUTH_COOKIE_SECRET / AE_AUTH_REDIRECT_URI -- see
# aliexpress_dashboard/dashboard/auth.py and the README.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generate-with-python3-c-import-secrets-print-secrets.token_urlsafe(32)"
client_id = "your-google-oauth-client-id"
client_secret = "your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
