# AliExpress Open Platform app credentials, from the "Drop Shipping" +
# "System Tool" permission groups. Leave blank while AE_MODE=fixture.
# Required once AE_MODE=live.
AE_APP_KEY=
AE_APP_SECRET=

# fixture | live
# fixture: client reads recorded responses from tests/fixtures/, no network calls, no credentials needed.
# live: client calls the real AliExpress Open Platform API using the credentials above.
AE_MODE=fixture

# Where the one-time OAuth authorize step redirects to. Must be HTTPS.
# example.com is a real, always-on domain you don't need to run anything on --
# the authorization `code` shows up in the browser's address bar after the
# redirect regardless of what page actually loads there. See README.
AE_CALLBACK_URL=https://example.com/callback

# Currency, language, and destination country every ds.* call is made with
# (target_sale_price, etc. are normalized into AE_TARGET_CURRENCY). A saved
# search can override the ship-to country per search. AE_TARGET_LANGUAGE
# needs a full locale, not a bare language code -- "en" fails the call
# outright (confirmed live), despite the docs' own example using "en".
AE_TARGET_CURRENCY=GBP
AE_TARGET_LANGUAGE=en_US
AE_SHIP_TO_COUNTRY=GB

# SQLite database file path.
AE_DB_PATH=./data/aliexpress_dashboard.db

# Where the OAuth access/refresh token is cached after the authorize step.
# Written programmatically -- don't hand-edit this file.
AE_TOKEN_PATH=./data/token.json

# Directory of fixture JSON files, used only when AE_MODE=fixture.
AE_FIXTURES_DIR=./tests/fixtures

# Rate limiting / backoff, all in seconds.
AE_MIN_REQUEST_INTERVAL_SECONDS=1.0
AE_MAX_RETRIES=5
AE_BACKOFF_BASE_SECONDS=1.0
AE_BACKOFF_MAX_SECONDS=60.0

# Shared secret the HTTP API (aliexpress_dashboard/api/) requires on every
# request via the X-API-Key header. Required to use the API at all -- it
# fails closed (rejects every request) if this is unset, rather than
# running open. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AE_API_KEY=
