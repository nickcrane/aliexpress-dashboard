# Copy to .env.local (gitignored, Vite loads it automatically).
#
# The API key here gets baked into the JS bundle at build time -- fine for
# this local-only test hitting a local/fixture-mode API, never something
# to ship to a real deployment like this (see the top-level README).

VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=local-verify-key

# From your Firebase project -> Project Settings -> General -> Your apps
# -> Web app. Not secret in the usual sense (meant to be public in a
# browser bundle -- Firebase's real security boundary is its server-side
# provider config, not this object). See README for full setup steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
