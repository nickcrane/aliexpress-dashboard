# Copy to .env.local (gitignored, Vite loads it automatically).

# Only needed if you want dev to call something other than the local
# proxy vite.config.ts already forwards /api/* to (localhost:8503) -- see
# README's "Run it locally". Leave unset for the normal dev setup.
# VITE_API_BASE_URL=

# From your Firebase project -> Project Settings -> General -> Your apps
# -> Web app. Not secret in the usual sense (meant to be public in a
# browser bundle -- Firebase's real security boundary is its server-side
# provider config, not this object). See README for full setup steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
