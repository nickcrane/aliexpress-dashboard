# Builds web-m3 (Vite/React) and serves it through
# aliexpress_dashboard/spa/app.py, which also proxies its API calls
# server-side so the AliExpress API key never reaches the browser bundle.
# Two languages in one deploy is why this is a hand-written Dockerfile
# rather than Railpack's auto-detected build (which picks one provider per
# service root, not both).

FROM node:22-slim AS webbuild
WORKDIR /build/web-m3
COPY web-m3/package.json web-m3/package-lock.json ./
RUN npm ci
COPY web-m3/ ./
# Vite inlines VITE_* vars into the bundle at build time, so they have to
# be present for this `npm run build`, not just at container runtime --
# Railway auto-passes a Dockerfile-built service's own env vars in as
# build args of the same name, but only for ARGs actually declared here.
# Not secret (see web-m3/README.md/.env.local.example): meant to be
# public in a browser bundle, same class of value the seed color or the
# Firebase project ID already are.
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
RUN npm run build

FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY aliexpress_dashboard/ ./aliexpress_dashboard/
COPY --from=webbuild /build/web-m3/dist ./web-m3/dist

ENV PORT=8080
CMD ["sh", "-c", "uvicorn aliexpress_dashboard.spa.app:app --host 0.0.0.0 --port $PORT"]
